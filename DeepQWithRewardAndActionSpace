import numpy as np
import tensorflow as tf
from tensorflow.keras.models import Sequential
from tensorflow.keras.layers import Dense
from tensorflow.keras.optimizers import Adam

# Define parameters
state_size = 5  # Number of features in the state space
learning_rate = 0.001
gamma = 0.95  # Discount factor for future rewards
episodes = 50  # Number of episodes to run
epsilon = 0.1  # Exploration rate
top_k_responses = ['Allow', 'Block', 'Substitute', 'Redirect', 'Monitor/Log', 'Terminate']  # Action space

# Define the state space (response time, session continuity, other variables)
# States: [Response Time, Session Continuity, Client Trust Score, Response Status Code, Error Flag]
state_list = [
    np.array([[150, 1, 0.9, 200, 0]]),  # State 1: Fast response, session intact, successful response
    np.array([[300, 0, 0.5, 500, 1]]),  # State 2: Slow response, session broken, failed response
    np.array([[250, 1, 0.7, 404, 0]])   # State 3: Medium response, session intact, not found error
]

# Build the Q-Network
def build_model(state_size, action_size):
    model = Sequential()
    model.add(Dense(24, input_shape=(state_size,), activation='relu'))  # Use `input_shape` correctly
    model.add(Dense(24, activation='relu'))
    model.add(Dense(action_size, activation='linear'))
    model.compile(loss='mse', optimizer=Adam(learning_rate=learning_rate))
    return model

# Function to choose an action (pick from top K responses)
def choose_action(state, epsilon):
    action_size = len(top_k_responses)  # Number of possible actions = number of top K responses
    if np.random.rand() <= epsilon:
        return np.random.choice(action_size)  # Random action (exploration)

    # Predict the Q-values for each top K response
    q_values = model.predict(state)
    return np.argmax(q_values[0])  # Action with the highest Q-value (exploitation)

# Function to simulate getting a reward based on response time and session continuity
def get_reward(action, state):
    response_time = state[0][0]  # First feature in the state
    session_continuity = state[0][1]  # Second feature in the state

    # Reward based on response time (lower is better) and session continuity (1 is good, 0 is bad)
    if action == 0:  # Allow
        return 10 - (response_time / 100) + (5 * session_continuity)
    elif action == 1:  # Block
        return 5 - (response_time / 200) + (3 * session_continuity)
    elif action == 2:  # Substitute
        return 7 - (response_time / 150) + (4 * session_continuity)
    elif action == 3:  # Redirect
        return 6 - (response_time / 150) + (2 * session_continuity)
    elif action == 4:  # Monitor/Log
        return 4 - (response_time / 200) + (2 * session_continuity)
    elif action == 5:  # Terminate
        return 3 - (response_time / 250) + (1 * session_continuity)
    return 0  # Default reward

# Initialize the model
model = build_model(state_size, len(top_k_responses))

# Training loop for 50 episodes
cumulative_rewards = []
loss_history = []
selected_responses = []

for episode in range(episodes):
    state_idx = np.random.choice(len(state_list))  # Randomly select the index of one of the predefined states
    state = state_list[state_idx]  # Access the state using the index
    total_reward = 0
    done = False

    # Run until done (single-step per episode for simplicity)
    while not done:
        # Select an action
        action = choose_action(state, epsilon)

        # Get the reward for the selected action based on response time and session continuity
        reward = get_reward(action, state)

        # Save the selected response
        selected_response = top_k_responses[action]
        selected_responses.append(selected_response)

        # Simulate the next state (keeping it constant for this example)
        next_state = state  # In real environments, this would change dynamically

        # Predict the target Q-value using the Bellman equation
        target = reward + gamma * np.amax(model.predict(next_state)[0])

        # Get current Q-value predictions
        q_values = model.predict(state)

        # Update the Q-value for the selected action
        q_values[0][action] = target

        # Train the model (fit) on the updated Q-values
        history = model.fit(state, q_values, epochs=1, verbose=0)

        # Update cumulative reward
        total_reward += reward

        # Save the loss for analysis
        loss = history.history['loss'][0]
        loss_history.append(loss)

        done = True  # End the episode after one step for simplicity

    # Save the cumulative reward for the episode
    cumulative_rewards.append(total_reward)
    print(f"Episode {episode + 1}/{episodes}: Total Reward: {total_reward}, Loss: {loss}, Selected Response: {selected_response}")

# Calculate average cumulative reward
average_cumulative_reward = np.mean(cumulative_rewards)

# Calculate average loss
average_loss = np.mean(loss_history)

# Calculate percentage of total loss reduction
initial_loss = loss_history[0]
final_loss = loss_history[-1]
loss_percent_reduction = ((initial_loss - final_loss) / initial_loss) * 100

# Output the results
print(f"\nAverage Cumulative Reward over {episodes} episodes: {average_cumulative_reward}")
print(f"Average Loss: {average_loss}")
print(f"Loss Reduction: {loss_percent_reduction:.2f}%")

# Output the final response
final_response = selected_responses[-1]
print(f"Final Selected Response: {final_response}")

